# CMake toolchain file: cross-compile for the Steam Frame (aarch64 SteamOS) with clang + lld and a sysroot copied from the
# device (toolchain/sync_sysroot.sh). -mcpu=cortex-x4 needs LLVM 18+ (use -march=armv8.2-a+lse with older ones).   cmake -DCMAKE_TOOLCHAIN_FILE=toolchain/aarch64-frame.cmake ...
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT DEFINED ENV{LLVM_ROOT})
  set(_llvm "$ENV{HOME}/.local/llvm-19.1.7")
else()
  set(_llvm "$ENV{LLVM_ROOT}")
endif()
if(NOT DEFINED ENV{SYSROOT})
  set(_sysroot "$ENV{HOME}/sysroots/steam-frame")
else()
  set(_sysroot "$ENV{SYSROOT}")
endif()
set(CMAKE_C_COMPILER   "${_llvm}/bin/clang")
set(CMAKE_CXX_COMPILER "${_llvm}/bin/clang++")
set(CMAKE_C_COMPILER_TARGET   aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_SYSROOT "${_sysroot}")
set(CMAKE_FIND_ROOT_PATH "${_sysroot}" "${_sysroot}/opt/ssbu-deps/sdl3")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_LINKER_TYPE LLD)
foreach(l EXE SHARED MODULE)
  set(CMAKE_${l}_LINKER_FLAGS_INIT "-fuse-ld=lld")
endforeach()
set(_f "-mcpu=cortex-x4 -w -fno-strict-aliasing -ffp-contract=off -fno-math-errno -fno-omit-frame-pointer")
set(CMAKE_C_FLAGS_INIT "${_f}")
set(CMAKE_CXX_FLAGS_INIT "${_f}")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${_sysroot}")
set(ENV{PKG_CONFIG_LIBDIR} "${_sysroot}/usr/lib/pkgconfig:${_sysroot}/usr/share/pkgconfig:${_sysroot}/opt/ssbu-deps/sdl3/lib/pkgconfig")
